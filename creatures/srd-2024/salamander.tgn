creatures:
- name: Salamander
  statblock:
    custom_statblock: |
      **Armor Class** 15  
      **Hit Points** 90 (rollable(dice=12d10 + 24,dicelabel=Hit Points))  
      **Speed** Walk 30 ft., Climb 30 ft.  
      **Initiative:** rollable(dice=1d20+2,label=+2,dicelabel=Initiative) (12)

